      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_1785182364008451]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, {FIXED [Customer_ID] : MIN([Transaction_Date])})' />
      </column>
      <column caption='Months Since Signup' datatype='integer' name='[Calculation_1785182364160004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_1785182364008451], DATETRUNC(&apos;month&apos;, [Transaction_Date]))' />
      </column>
      <column caption='StartOf Month' datatype='datetime' name='[Calculation_1785182373117958]' role='dimension' type='quantitative'>
